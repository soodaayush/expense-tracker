{
  "name": "expense-tracking-app",
  "private": true,
  "scripts": {
    "dev:azurite": "azurite --silent --location ./.azurite --debug ./.azurite/debug.log",
    "dev:sql": "docker compose -f sql/docker-compose.yml up -d",
    "dev:sql:down": "docker compose -f sql/docker-compose.yml down",
    "db:migrate": "node sql/migrate.js",
    "predev": "npm run build --prefix api",
    "dev": "swa start http://localhost:5173 --api-location ./api --run \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend && npm run typecheck --prefix api"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.0.2",
    "azurite": "^3.30.0",
    "mssql": "^11.0.1"
  }
}
