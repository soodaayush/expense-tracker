# Most of these map to Azure Static Web Apps "Application settings" (prod/staging) and to
# api/local.settings.json for local development. The three notification-specific ones at the
# bottom are different: they belong to the separate standalone notifications-worker Function
# App (see notifications-worker/README or the root README's notifications section for why it's
# separate — Static Web Apps' managed Functions only support HTTP triggers, not the timer
# trigger that job needs) and its own local.settings.json.
# See README.md for how/where to set each one.

SQL_SERVER=localhost
SQL_PORT=14330
SQL_DATABASE=BillTracker
SQL_USER=sa
SQL_PASSWORD=generate-a-strong-password
SQL_TRUST_SERVER_CERT=true
RP_ID=localhost
ORIGIN=http://localhost:4280
SESSION_SECRET=generate-a-long-random-string

# --- notifications-worker only (standalone Function App, not the SWA-managed api/) ---
# Also needs its own copies of SQL_SERVER/PORT/DATABASE/USER/PASSWORD/TRUST_SERVER_CERT and
# ORIGIN from above — it talks to the same database and links back to the same app in emails.
ACS_CONNECTION_STRING=endpoint=https://<your-acs-resource>.communication.azure.com/;accesskey=<key>
NOTIFICATION_SENDER_EMAIL=DoNotReply@<your-managed-domain>.azurecomm.net
