# These map to Azure Static Web Apps "Application settings" in production,
# and to api/local.settings.json for local development.
# See README.md for how/where to set each one.

AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
RP_ID=localhost
ORIGIN=http://localhost:4280
SESSION_SECRET=generate-a-long-random-string
SETUP_TOKEN=generate-a-random-value-then-delete-after-first-passkey-registration
